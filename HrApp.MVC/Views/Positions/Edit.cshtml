@model HrApp.MVC.Models.PositionViewModel

@{
    var parentOptions = ViewBag.ParentOptions as List<SelectListItem> ?? new List<SelectListItem>();
}

<h4 class="mb-4">პოზიციის რედაქტირება</h4>

<form asp-action="Edit" method="post" class="card shadow-sm">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label">დასახელება</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ParentPositionId" class="form-label">მშობელი პოზიცია</label>
            @Html.DropDownListFor(m => m.ParentPositionId, parentOptions, new { @class = "form-select" })
            <span asp-validation-for="ParentPositionId" class="text-danger"></span>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">უკან</a>
        <button type="submit" class="btn btn-primary">შენახვა</button>
    </div>
</form>

<partial name="_ValidationScriptsPartial" />

