@model HrApp.MVC.Models.PositionsPageViewModel

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">პოზიციების სია</h4>
                    <a class="btn btn-success" asp-action="Create">+ დამატება</a>
                </div>

                @if (!Model.Positions.Any())
                {
                    <div class="text-muted">ჩანაწერები არ მოიძებნა</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>დასახელება</th>
                                    <th>მშობელი</th>
                                    <th class="text-end">ქმედებები</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var pos in Model.Positions)
                            {
                                <tr>
                                    <td>@pos.Title</td>
                                    <td>@(string.IsNullOrWhiteSpace(pos.ParentTitle) ? "(ფესვი)" : pos.ParentTitle)</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@pos.Id">რედაქტირება</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@pos.Id">წაშლა</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">პოზიციების იერარქია</h5>
                <div class="position-tree-wrapper">
                    @await Html.PartialAsync("_PositionTree", Model.Tree)
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .position-tree-wrapper {
        max-height: 520px;
        overflow-y: auto;
        padding-right: 0.5rem;
    }

    .position-tree li {
        margin-bottom: 0.25rem;
        position: relative;
        padding-left: 1rem;
    }

    .position-tree li::before {
        content: "";
        position: absolute;
        left: 0.3rem;
        top: 0.7rem;
        width: 0.6rem;
        height: 0;
        border-top: 1px solid #cbd5f5;
    }

    .position-tree li::after {
        content: "";
        position: absolute;
        left: 0.3rem;
        top: -0.4rem;
        bottom: -0.4rem;
        border-left: 1px solid #cbd5f5;
    }

    .position-tree li:last-child::after {
        height: 0.7rem;
    }

    .position-tree li span {
        background: #f8f9fa;
        padding: 0.15rem 0.4rem;
        border-radius: 0.4rem;
        display: inline-block;
    }
</style>

