@model HrApp.MVC.Models.RegisterViewModel

<form asp-action="Register" method="post">
    <input asp-for="PersonalNumber" placeholder="პირადი ნომერი" />
    <input asp-for="FirstName" placeholder="სახელი" />
    <input asp-for="LastName" placeholder="გვარი" />
    <input asp-for="Email" placeholder="Email" />
    <input asp-for="Password" type="password" placeholder="Password" />
    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
    <button type="submit">Register</button>
</form>
