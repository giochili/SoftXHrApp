@model HrApp.MVC.Models.LoginViewModel

<div class="login-container d-flex justify-content-center align-items-center">
    <div class="login-card-wrapper col-11 col-md-6 col-lg-4">
        <div class="card login-card">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-4 text-center text-primary fw-bold">შესვლა</h3>
                <form method="post" action="/Account/Login">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input id="Email" name="Email" type="email" class="form-control" placeholder="Email" value="@Model?.Email" required />
                        <label for="Email">Email</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input id="Password" name="Password" type="password" class="form-control" placeholder="Password" required />
                        <label for="Password">პაროლი</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">შესვლა</button>
                        <a asp-action="Register" class="btn btn-outline-secondary btn-lg">რეგისტრაცია</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />

<style>
    /* ======= PAGE-SPECIFIC STYLES ======= */
    .login-container {
        max-height: 100vh;
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    .login-card-wrapper {
        max-width: 420px;
        width: 100%;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 1.2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .login-card:hover {
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
    }

    h3 {
        color: #333;
        letter-spacing: 0.5px;
    }

    .form-control {
        border-radius: 0.6rem;
        padding: 1rem 0.75rem;
        border: 1px solid #dee2e6;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .form-control:focus {
        border-color: #2575fc;
        box-shadow: 0 0 0 0.2rem rgba(37, 117, 252, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none;
        border-radius: 0.6rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary:hover {
        box-shadow: 0 6px 15px rgba(37, 117, 252, 0.3);
    }

    .btn-outline-secondary {
        border-radius: 0.6rem;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .btn-outline-secondary:hover {
        background-color: #f1f1f1;
        color: #000;
    }

    .text-danger {
        font-size: 0.85rem;
    }

    /* ======= RESPONSIVE TWEAKS ======= */
    @@media (max-width: 768px) {
        .login-card {
            padding: 1.5rem;
        }

        .login-card-wrapper {
            max-width: 90%;
        }
    }

    @@media (max-width: 576px) {
        h3 {
            font-size: 1.5rem;
        }

        .btn {
            font-size: 1rem;
        }

        .login-card {
            border-radius: 1rem;
        }
    }
</style>
